{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiTerm",
  "version": "1.0.3",
  "identifier": "com.na4codex.piterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PiTerm",
        "width": 1152,
        "height": 789,
        "minWidth": 1152,
        "minHeight": 789,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: tauri: https: data: blob:; font-src 'self' asset: tauri: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Na4Codex",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}